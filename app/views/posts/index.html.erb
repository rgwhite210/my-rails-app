<h1 class="text-4xl font-bold text-blue-700 mb-8 text-center"><%= t('posts.index.title') %></h1>

<% @posts.each do |post| %>
  <div class="bg-white p-6 mb-4 shadow rounded">
    <h2 class="text-xl font-semibold"><%= post.title %></h2>
    <p class="text-gray-700"><%= truncate(post.body, length: 100) %></p>
    <div class="mt-2 space-x-2">
      <%= link_to t('posts.index.show'), post, class: "text-blue-600 hover:underline" %>
      <%= link_to t('posts.index.edit'), edit_post_path(post), class: "text-yellow-600 hover:underline" %>
      <%= link_to t('posts.index.delete'), post, method: :delete, data: { confirm: t('posts.index.confirm_delete') }, class: "text-red-600 hover:underline" %>
    </div>
  </div>
<% end %>


<div class="mt-10 text-center">
  <%= link_to t('posts.index.new_post'), new_post_path, class: "bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded" %>
</div>