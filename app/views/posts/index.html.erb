<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
  <h1 class="text-4xl font-bold text-blue-700 mb-8 text-center">Blog Posts</h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @posts.each do |post| %>
      <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-200 p-6 flex flex-col justify-between">
        <div>
          <h2 class="text-xl font-semibold text-gray-800 mb-2"><%= post.title %></h2>
          <p class="text-gray-600 text-sm mb-4"><%= truncate(post.body, length: 120) %></p>
        </div>
        <div class="mt-auto pt-4 flex justify-between text-sm">
          <%= link_to 'Show', post, class: "text-blue-600 hover:underline" %>
          <%= link_to 'Edit', edit_post_path(post), class: "text-yellow-500 hover:underline" %>
          <%= link_to 'Delete', post, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-500 hover:underline" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-10 text-center">
    <%= link_to 'New Post', new_post_path, class: "inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg shadow" %>
  </div>
</div>
