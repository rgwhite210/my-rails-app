<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div style="color: red">
      <h2>
        <%= t('forms.errors.header', count: post.errors.count) %>
      </h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, t('activerecord.attributes.post.title'), style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :body, t('activerecord.attributes.post.body'), style: "display: block" %>
    <%= form.text_area :body %>
  </div>

  <div>
    <%= form.submit t('forms.submit') %>
  </div>
<% end %>
